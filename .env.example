# Copy this file to .env and adjust values before running `docker compose up`.
# Do not commit the real .env file.

# --- PostgreSQL ---
POSTGRES_DB=airquality
POSTGRES_USER=airquality
POSTGRES_PASSWORD=change-me

# --- Sensor ---
# Local-network URL of the air-quality sensor's HTTP API.
SENSOR_URL=http://192.168.0.1/measures/current
# How often to poll the sensor, in seconds. 900 = 15 minutes.
COLLECTION_INTERVAL_SECONDS=900

# --- Time ---
# IANA timezone used for 15-minute bucketing and display.
TIMEZONE=Europe/Prague

# --- Backend ---
# Comma-separated list of origins allowed to call the API (CORS).
# Only relevant if you access the backend directly, outside the bundled
# nginx/Docker Compose setup.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
# Set to false to stop storing the sensor's full raw JSON response
# alongside each measurement (see README "Why store the raw payload?").
STORE_RAW_PAYLOAD=true

# --- Frontend ---
# Port the frontend is published on when running via Docker Compose.
FRONTEND_PORT=8080
# Port the backend API is published on when running via Docker Compose.
BACKEND_PORT=8000
